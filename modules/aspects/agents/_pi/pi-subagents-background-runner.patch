+import { randomUUID } from "node:crypto";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+import type {
+	ExtensionAPI,
+	ExtensionContext,
+} from "@earendil-works/pi-coding-agent";
+import { resolveSessionArtifactPath } from "../artifact-storage.ts";
+import type { RunningCompanion, SubagentResult } from "../types.ts";
+import { routeSubagentOutcome } from "./result-router.ts";
+import {
+	claimSpawnWidthSlot,
+	getSpawnWidthLimit,
+	tryAcquireSlots,
+} from "./spawn-width.ts";
+import { runningSubagents, widgetManager } from "./state.ts";
+import {
+	checkSubagentTimeout,
+	formatTimeoutSeconds,
+	getSubagentHardDeadlineAt,
+} from "./timeout-budget.ts";
+
+const SUBMIT_CHANNEL = "pi-subagents:background-runner:v1:submit";
+const MAX_TIMER_MS = 2 ** 31 - 1;
+
+interface RunnerReport {
+	ok: boolean;
+	report: string;
+	saveReport?: boolean;
+	cleanupWarning?: string;
+}
+
+type SubmissionReply =
+	| { id: string; completion: Promise<void> }
+	| { error: string };
+
+interface Submission {
+	name: string;
+	title: string;
+	timeoutSeconds: number;
+	run(input: { cwd: string; signal: AbortSignal }): Promise<RunnerReport>;
+	reply(response: SubmissionReply): void;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null;
+}
+
+function isSubmission(
+	value: Record<string, unknown>,
+): value is Record<string, unknown> & Submission {
+	return (
+		typeof value.reply === "function" &&
+		typeof value.run === "function" &&
+		typeof value.name === "string" &&
+		/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(value.name) &&
+		value.name.length <= 32 &&
+		typeof value.title === "string" &&
+		value.title.trim().length > 0 &&
+		value.title.length <= 100 &&
+		!/\p{Cc}/u.test(value.title) &&
+		typeof value.timeoutSeconds === "number" &&
+		value.timeoutSeconds >= 0.001 &&
+		value.timeoutSeconds * 1000 <= MAX_TIMER_MS
+	);
+}
+
+function isRunnerReport(value: unknown): value is RunnerReport {
+	return (
+		isRecord(value) &&
+		typeof value.ok === "boolean" &&
+		typeof value.report === "string" &&
+		value.report.trim().length > 0 &&
+		(value.saveReport === undefined || typeof value.saveReport === "boolean") &&
+		(value.cleanupWarning === undefined ||
+			typeof value.cleanupWarning === "string")
+	);
+}
+
+function errorMessage(error: unknown): string {
+	return (error instanceof Error ? error.message : String(error)).replace(
+		/\p{Cc}/gu,
+		"",
+	);
+}
+
+function saveRunnerReport(
+	cwd: string,
+	sessionId: string,
+	filename: string,
+	report: string,
+): string {
+	try {
+		const path = resolveSessionArtifactPath(cwd, sessionId, filename);
+		mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+		writeFileSync(path, report, { encoding: "utf8", flag: "wx", mode: 0o600 });
+		return `\n\nReport saved to: ${path.replace(/\p{Cc}/gu, "")}`;
+	} catch (error) {
+		const code = (error as NodeJS.ErrnoException).code;
+		return `\n\nCould not save the report artifact${code ? ` (${code})` : ""}; the report is shown above.`;
+	}
+}
+
+async function runWithLifecycle(
+	running: RunningCompanion,
+	submit: Submission,
+	cwd: string,
+	sessionId: string | undefined,
+	ownerSignal: AbortSignal,
+): Promise<SubagentResult> {
+	const signal = AbortSignal.any([running.abortController.signal, ownerSignal]);
+	const deadlineAt = getSubagentHardDeadlineAt(running);
+	let timer: ReturnType<typeof setTimeout> | undefined;
+	function enforceDeadline(schedule: boolean) {
+		if (signal.aborted) return;
+		const expiry = checkSubagentTimeout(running, Date.now());
+		if (expiry) {
+			running.timeoutExpiry = expiry;
+			running.abortController.abort();
+		} else if (schedule && deadlineAt !== undefined) {
+			timer = setTimeout(
+				() => enforceDeadline(true),
+				Math.max(1, Math.min(MAX_TIMER_MS, deadlineAt - Date.now())),
+			);
+		}
+	}
+
+	let outcome: RunnerReport = {
+		ok: false,
+		report: "The runner did not start.",
+	};
+	let summarySource: SubagentResult["summarySource"] = "runtime";
+	try {
+		enforceDeadline(true);
+		if (!signal.aborted) {
+			const result = await submit.run({ cwd, signal });
+			if (!isRunnerReport(result))
+				throw new Error("Invalid background runner result.");
+			outcome = result;
+			summarySource = "subagent";
+		}
+	} catch (error) {
+		outcome = { ok: false, report: `Runner failed: ${errorMessage(error)}` };
+	} finally {
+		// Check again in case completion raced the timer callback.
+		enforceDeadline(false);
+		clearTimeout(timer);
+	}
+
+	const expiry = running.timeoutExpiry;
+	let summary = expiry
+		? `Exceeded the ${formatTimeoutSeconds(expiry.seconds)} whole-run limit; no complete report was accepted.`
+		: signal.aborted
+			? "Run cancelled."
+			: outcome.report;
+	if (outcome.cleanupWarning) summary += `\n\n${outcome.cleanupWarning}`;
+	if (!signal.aborted && outcome.saveReport && sessionId) {
+		summary += saveRunnerReport(
+			cwd,
+			sessionId,
+			`${running.name}-${running.id}.md`,
+			summary,
+		);
+	}
+	return {
+		name: running.name,
+		task: running.task,
+		summary,
+		summarySource: signal.aborted ? "runtime" : summarySource,
+		exitCode: !signal.aborted && outcome.ok && !outcome.cleanupWarning ? 0 : 1,
+		elapsed: Math.floor((Date.now() - running.startTime) / 1000),
+		...(expiry
+			? { timedOut: expiry.kind, timedOutAfter: expiry.seconds }
+			: signal.aborted
+				? { error: "cancelled" }
+				: {}),
+		...(outcome.cleanupWarning ? { timeoutKillFailed: true } : {}),
+	};
+}
+
+export function registerBackgroundRunnerSubmission(
+	pi: ExtensionAPI,
+	formatElapsed: (seconds: number) => string,
+): (ctx?: ExtensionContext) => void {
+	let origin:
+		| { ctx: ExtensionContext; controller: AbortController }
+		| undefined;
+	pi.events?.on(SUBMIT_CHANNEL, (data) => {
+		if (!isRecord(data) || typeof data.reply !== "function") return;
+		if (!isSubmission(data)) {
+			data.reply({ error: "Invalid v1 background runner submission." });
+			return;
+		}
+		if (!origin) {
+			data.reply({
+				error: "No active Pi session for background runner submission.",
+			});
+			return;
+		}
+		const { ctx, controller } = origin;
+		const cwd = ctx.cwd;
+		const sessionId = ctx.sessionManager.getSessionFile()
+			? ctx.sessionManager.getSessionId()
+			: undefined;
+		if (!tryAcquireSlots(1, getSpawnWidthLimit())) {
+			data.reply({
+				error:
+					"Subagent concurrency limit reached; wait for another run to finish.",
+			});
+			return;
+		}
+
+		const running: RunningCompanion = {
+			id: randomUUID().slice(0, 8),
+			runner: "companion",
+			name: data.name,
+			title: data.title,
+			task: data.title,
+			mode: "background",
+			executionState: "running",
+			activity: "running",
+			deliveryState: "detached",
+			parentClosePolicy: "terminate",
+			async: true,
+			noSession: true,
+			reportContextUsage: false,
+			timeoutBudget: { timeoutSeconds: data.timeoutSeconds },
+			abortController: new AbortController(),
+			startTime: Date.now(),
+			// Defer execution until the slot, watcher and acknowledgement are installed.
+			completionPromise: Promise.resolve().then(async () => {
+				const result = await runWithLifecycle(
+					running,
+					data,
+					cwd,
+					sessionId,
+					controller.signal,
+				);
+				if (controller.signal.aborted) running.allowSteerDelivery = false;
+				try {
+					routeSubagentOutcome({
+						pi,
+						running,
+						result,
+						formatElapsed,
+						updateWidget: () => widgetManager.update(),
+					});
+				} catch (error) {
+					// Never fall back to the Pi-child watcher error path: it starts a turn.
+					console.error(
+						`Could not route companion result (${running.id}):`,
+						error,
+					);
+				}
+				return result;
+			}),
+		};
+		claimSpawnWidthSlot(running);
+		runningSubagents.set(running.id, running);
+		data.reply({
+			id: running.id,
+			completion: running.completionPromise.then(() => {}),
+		});
+		if (ctx.hasUI) widgetManager.startRefresh();
+	});
+	// Pi can rebind extensions without re-evaluating their imported modules.
+	// Each origin gets a fresh signal, independent of the module's lifetime.
+	return (ctx) => {
+		const previous = origin;
+		origin = ctx ? { ctx, controller: new AbortController() } : undefined;
+		previous?.controller.abort();
+	};
+}
