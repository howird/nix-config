+import type { TestContext } from "node:test";
+import type {
+	ExtensionAPI,
+	ExtensionContext,
+} from "@earendil-works/pi-coding-agent";
+import { resolveSessionArtifactPath } from "../../src/artifact-storage.ts";
+import { outstandingWork } from "../../src/runtime/outstanding-work.ts";
+import { getLiveSlotCount } from "../../src/runtime/spawn-width.ts";
+import { runningSubagents, widgetManager } from "../../src/runtime/wiring.ts";
+import {
+	buildCompletedItems,
+	buildRunningItems,
+} from "../../src/tools/overlay/data.ts";
+import {
+	assert,
+	createTestDir,
+	describe,
+	existsSync,
+	getCompletedSubagentResultForTest,
+	it,
+	join,
+	mkdirSync,
+	readFileSync,
+	resetSubagentStateForTest,
+	rmSync,
+	sleep,
+	subagentsExtension,
+	writeFileSync,
+} from "../support/index.ts";
+
+const SUBMIT = "pi-subagents:background-runner:v1:submit";
+type Reply =
+	| { id: string; completion: Promise<void> }
+	| { error: string }
+	| undefined;
+type RunInput = { cwd: string; signal: AbortSignal };
+
+function setup(t: TestContext, { enabled = true, persistent = true } = {}) {
+	resetSubagentStateForTest();
+	const dir = createTestDir();
+	const cwd = join(dir, "work with spaces");
+	const config = join(dir, "config");
+	mkdirSync(cwd);
+	mkdirSync(join(config, "agents"), { recursive: true });
+	if (enabled)
+		writeFileSync(
+			join(config, "agents", "worker.md"),
+			"---\nname: worker\n---\nWorker body.\n",
+		);
+	process.env.PI_CODING_AGENT_DIR = config;
+	process.env.PI_ARTIFACT_PROJECT_ROOT = join(dir, "artifacts");
+	process.env.PI_SUBAGENT_SPAWN_WIDTH = "1";
+	process.env.PI_SUBAGENT_SPAWN_WIDTH_EFFECTIVE = "1";
+
+	const topics = new Map<string, (data: unknown) => void>();
+	const handlers = new Map<
+		string,
+		Array<
+			(event: { reason: string }, ctx: ExtensionContext) => void | Promise<void>
+		>
+	>();
+	const sent: Array<Parameters<ExtensionAPI["sendMessage"]>> = [];
+	const pi = {
+		on(
+			event: string,
+			handler: (
+				event: { reason: string },
+				ctx: ExtensionContext,
+			) => void | Promise<void>,
+		) {
+			const registered = handlers.get(event) ?? [];
+			registered.push(handler);
+			handlers.set(event, registered);
+		},
+		events: {
+			on: (topic: string, handle: (data: unknown) => void) =>
+				topics.set(topic, handle),
+		},
+		registerCommand() {},
+		registerTool() {},
+		registerShortcut() {},
+		registerMessageRenderer() {},
+		getActiveTools: () => [],
+		setActiveTools() {},
+		appendEntry() {},
+		sendMessage(...args: Parameters<ExtensionAPI["sendMessage"]>) {
+			sent.push(args);
+		},
+	} as unknown as ExtensionAPI;
+	const ctx = {
+		cwd,
+		hasUI: true,
+		ui: {
+			notify() {},
+			setWidget() {},
+			theme: {
+				fg: (_tone: string, text: string) => text,
+				bold: (text: string) => text,
+			},
+		},
+		sessionManager: {
+			getSessionId: () => "parent",
+			getSessionFile: () =>
+				persistent ? join(dir, "parent-not-written.jsonl") : undefined,
+		},
+	} as unknown as ExtensionContext;
+	const prevCwd = process.cwd();
+	process.chdir(cwd);
+	try {
+		subagentsExtension(pi);
+	} finally {
+		process.chdir(prevCwd);
+	}
+	async function emitSession(event: string, reason: string) {
+		for (const handler of handlers.get(event) ?? [])
+			await handler({ reason }, ctx);
+	}
+	t.after(async () => {
+		await emitSession("session_shutdown", "quit");
+		resetSubagentStateForTest();
+		widgetManager.attachContext({ hasUI: false } as ExtensionContext);
+		rmSync(dir, { recursive: true, force: true });
+	});
+	return {
+		ctx,
+		cwd,
+		sent,
+		start: () => emitSession("session_start", "startup"),
+		shutdown: () => emitSession("session_shutdown", "new"),
+		submit(
+			run: (input: RunInput) => unknown,
+			metadata: Record<string, unknown> = {},
+			topic = SUBMIT,
+		): Reply {
+			let ack: Reply;
+			topics.get(topic)?.({
+				name: "local-report",
+				title: "Local workspace report",
+				timeoutSeconds: 1,
+				run,
+				...metadata,
+				reply(result: Reply) {
+					ack = result;
+				},
+			});
+			return ack;
+		},
+	};
+}
+
+function accepted(reply: Reply) {
+	assert.ok(reply && "id" in reply, JSON.stringify(reply));
+	return reply;
+}
+
+function deferred() {
+	let finish!: () => void;
+	const done = new Promise<void>((resolve) => {
+		finish = resolve;
+	});
+	return { done, finish };
+}
+
+function waitForAbort(signal: AbortSignal) {
+	return new Promise<void>((resolve) =>
+		signal.addEventListener("abort", () => resolve(), { once: true }),
+	);
+}
+
+const report =
+	"# Report findings\n\n" +
+	"context ".repeat(1500) +
+	"\n\n- src/foo.ts:42: lost update 🧪";
+
+describe("background runner submission v1", () => {
+	it("uses the origin cwd, enforces shared width, and routes the complete report without a turn", async (t) => {
+		const { ctx, cwd, sent, start, submit } = setup(t);
+		await start();
+		const pending = deferred();
+		t.after(pending.finish);
+		const { id, completion } = accepted(
+			submit(async ({ cwd: actualCwd, signal }) => {
+				assert.equal(actualCwd, cwd);
+				assert.equal(signal.aborted, false);
+				await Promise.race([pending.done, waitForAbort(signal)]);
+				return { ok: true, report, saveReport: true };
+			}),
+		);
+		const running = runningSubagents.get(id);
+		assert.equal(running?.mode, "background");
+		assert.equal(running.sessionFile, undefined);
+		assert.equal(running.modelRef, undefined);
+		assert.equal(getLiveSlotCount(), 1);
+		const [item] = buildRunningItems(ctx);
+		assert.ok(item.canKill);
+		assert.ok(!item.canResume);
+		assert.match(
+			widgetManager.renderForTest().join("\n"),
+			/Local workspace report/,
+		);
+		assert.match(
+			(submit(() => assert.fail("over width")) as { error: string }).error,
+			/concurrency limit reached/,
+		);
+		assert.equal(sent.length, 0);
+
+		t.after(outstandingWork.subscribe(() => {}));
+		pending.finish();
+		await completion;
+		assert.equal(getLiveSlotCount(), 0);
+		assert.equal(runningSubagents.size, 0);
+		assert.equal(outstandingWork.count, 0);
+		assert.equal(getCompletedSubagentResultForTest(id)?.status, "completed");
+		assert.equal(sent.length, 1);
+		const [[message, delivery]] = sent;
+		assert.equal(message.customType, "subagent_result");
+		assert.equal(message.display, true);
+		assert.equal(delivery?.triggerTurn, false);
+		const path = resolveSessionArtifactPath(
+			cwd,
+			"parent",
+			`local-report-${id}.md`,
+		);
+		assert.ok(
+			String(message.content).endsWith(`${report}\n\nReport saved to: ${path}`),
+		);
+		assert.doesNotMatch(
+			String(message.content),
+			/Resume:|Session:|Sub-agent context:/,
+		);
+		assert.equal(readFileSync(path, "utf8"), report);
+		const sessionFile = ctx.sessionManager.getSessionFile();
+		assert.ok(sessionFile && !existsSync(sessionFile));
+		const [finished] = await buildCompletedItems(ctx);
+		assert.equal(finished.id, id);
+		assert.ok(!finished.canResume);
+	});
+
+	it("cancels through the overlay and awaits cleanup even if the callback returns a successful report", async (t) => {
+		const { ctx, sent, start, submit } = setup(t);
+		await start();
+		let cleaned = false;
+		const ready = deferred();
+		const { id } = accepted(
+			submit(async ({ signal }) => {
+				ready.finish();
+				await waitForAbort(signal);
+				await sleep(20);
+				cleaned = true;
+				return { ok: true, report };
+			}),
+		);
+		await ready.done;
+		const { onKill } = buildRunningItems(ctx)[0];
+		assert.ok(onKill);
+		await onKill();
+		assert.ok(cleaned);
+		assert.equal(getCompletedSubagentResultForTest(id)?.status, "cancelled");
+		assert.equal(getLiveSlotCount(), 0);
+		assert.match(String(sent[0][0].content), /cancelled/);
+		assert.equal(sent[0][1]?.triggerTurn, false);
+	});
+
+	it("aborts at the deadline and rejects a late success while keeping its cleanup diagnostic", async (t) => {
+		const { sent, start, submit } = setup(t);
+		await start();
+		const { id, completion } = accepted(
+			submit(
+				async ({ signal }) => {
+					await waitForAbort(signal);
+					await sleep(20);
+					return {
+						ok: true,
+						report,
+						saveReport: true,
+						cleanupWarning: "Resource cleanup could not be confirmed.",
+					};
+				},
+				{ timeoutSeconds: 0.1 },
+			),
+		);
+		await completion;
+		const result = getCompletedSubagentResultForTest(id);
+		assert.equal(result?.timedOut, "timeout");
+		assert.equal(result?.timedOutAfter, 0.1);
+		assert.equal(result?.status, "failed");
+		assert.match(
+			String(sent[0][0].content),
+			/timed out[\s\S]+Resource cleanup could not be confirmed/,
+		);
+		assert.doesNotMatch(
+			String(sent[0][0].content),
+			/# Report findings|Report saved to:/,
+		);
+		assert.equal(sent[0][1]?.triggerTurn, false);
+	});
+
+	it("cancels on session replacement, awaits cleanup, and suppresses the origin report", async (t) => {
+		const { sent, start, submit, shutdown } = setup(t);
+		await start();
+		let cleaned = false;
+		const ready = deferred();
+		accepted(
+			submit(async ({ signal }) => {
+				ready.finish();
+				await waitForAbort(signal);
+				await sleep(20);
+				cleaned = true;
+				return { ok: true, report, saveReport: true };
+			}),
+		);
+		await ready.done;
+		await shutdown();
+		assert.ok(cleaned);
+		assert.equal(runningSubagents.size, 0);
+		assert.equal(getLiveSlotCount(), 0);
+		assert.equal(sent.length, 0);
+		assert.match(
+			(submit(() => assert.fail()) as { error: string }).error,
+			/No active Pi session/,
+		);
+
+		// Pi can reuse imported modules on replacement. The next session still runs.
+		await start();
+		const next = accepted(submit(async () => ({ ok: true, report })));
+		await next.completion;
+		assert.equal(
+			getCompletedSubagentResultForTest(next.id)?.status,
+			"completed",
+		);
+		assert.equal(sent.length, 1);
+	});
+
+	it("validates submissions and reports, and keeps runner failures on the no-turn path", async (t) => {
+		const { sent, start, submit } = setup(t, { persistent: false });
+		const unexpected = () => assert.fail("invalid submission started");
+		assert.match(
+			(submit(unexpected) as { error: string }).error,
+			/No active Pi session/,
+		);
+		await start();
+		assert.equal(
+			submit(unexpected, {}, "pi-subagents:background-runner:v2:submit"),
+			undefined,
+		);
+		for (const bad of [
+			{ name: "../oops" },
+			{ title: "\u001b[1m" },
+			{ timeoutSeconds: Infinity },
+			{ run: 1 },
+		]) {
+			assert.match(
+				(submit(unexpected, bad) as { error: string }).error,
+				/Invalid v1/,
+			);
+		}
+		const malformed = accepted(submit(async () => ({ ok: 1, report })));
+		await malformed.completion;
+		const rejected = accepted(
+			submit(async () => {
+				throw new Error("callback failed");
+			}),
+		);
+		await rejected.completion;
+		const partial = accepted(
+			submit(async () => ({ ok: false, report, saveReport: true })),
+		);
+		await partial.completion;
+		assert.equal(getLiveSlotCount(), 0);
+		assert.ok(sent.every((entry) => entry[1]?.triggerTurn === false));
+		assert.match(
+			String(sent[0][0].content),
+			/Invalid background runner result/,
+		);
+		assert.match(String(sent[1][0].content), /callback failed/);
+		assert.doesNotMatch(String(sent[2][0].content), /Report saved to:/);
+	});
+
+	it("does not expose the API when the named-agent surface is disabled", async (t) => {
+		const { submit, start } = setup(t, { enabled: false });
+		await start();
+		assert.equal(
+			submit(() => assert.fail("runner started without an enabled agent")),
+			undefined,
+		);
+	});
+});
